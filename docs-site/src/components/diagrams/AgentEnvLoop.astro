---
/**
 * AgentEnvLoop — the two-participant loop that all of RL reduces to.
 *
 * Mirrors slide 3 of the presentation: agent on the left in spark, environment
 * on the right in cyan, one arrow each way carrying `action` and
 * `state + reward`. The two arrow labels are the whole legend, so this diagram
 * deliberately has none.
 *
 * Icons are hand-drawn paths rather than emoji — emoji render as full-colour
 * glyphs that fight the palette and vary by platform.
 *
 * Theme-aware via CSS custom properties — see the `.diagram` block in
 * noeira.css.
 */
---

<figure class="diagram not-content">
	<svg viewBox="0 0 880 210" role="img"
		aria-label="The agent sends an action to the environment; the environment returns a state and a reward">
		<defs>
			<marker id="ael-spark" viewBox="0 0 10 10" refX="9" refY="5"
				markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" class="dg-fill-spark" />
			</marker>
			<marker id="ael-cyan" viewBox="0 0 10 10" refX="9" refY="5"
				markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" class="dg-fill-cyan" />
			</marker>
		</defs>

		<!-- ── agent ───────────────────────────────────────────────── -->
		<g class="dg-node dg-node--spark">
			<rect x="0" y="20" width="270" height="170" rx="14" />

			<!-- robot glyph -->
			<circle cx="56" cy="66" r="27" class="dg-icon-bg dg-icon-bg--spark" />
			<g class="dg-icon dg-icon--spark">
				<rect x="43" y="57" width="26" height="21" rx="6" />
				<path d="M 56 57 L 56 50" />
				<path d="M 51 71 L 61 71" />
			</g>
			<circle cx="51" cy="49" r="2.5" class="dg-fill-spark" />
			<circle cx="61" cy="49" r="2.5" class="dg-fill-spark" />
			<circle cx="51" cy="65" r="2.6" class="dg-fill-spark" />
			<circle cx="61" cy="65" r="2.6" class="dg-fill-spark" />

			<text x="100" y="74" class="dg-title dg-title--left">AGENT</text>
			<text x="26" y="140" class="dg-sub dg-sub--left">A policy that decides</text>
			<text x="26" y="160" class="dg-sub dg-sub--left">what to do next</text>
		</g>

		<!-- ── environment ─────────────────────────────────────────── -->
		<g class="dg-node dg-node--cyan">
			<rect x="610" y="20" width="270" height="170" rx="14" />

			<!-- gamepad glyph -->
			<circle cx="666" cy="66" r="27" class="dg-icon-bg dg-icon-bg--cyan" />
			<g class="dg-icon dg-icon--cyan">
				<rect x="650" y="56" width="32" height="20" rx="9" />
				<path d="M 655 66 L 663 66" />
				<path d="M 659 62 L 659 70" />
			</g>
			<circle cx="672" cy="63" r="2.4" class="dg-fill-cyan" />
			<circle cx="677" cy="69" r="2.4" class="dg-fill-cyan" />

			<text x="710" y="74" class="dg-title dg-title--left">ENVIRONMENT</text>
			<text x="636" y="140" class="dg-sub dg-sub--left">The world: physics,</text>
			<text x="636" y="160" class="dg-sub dg-sub--left">game, or simulation</text>
		</g>

		<!-- ── the loop ────────────────────────────────────────────── -->
		<path class="dg-edge dg-edge--spark" marker-end="url(#ael-spark)"
			d="M 270 76 L 600 76" />
		<text x="440" y="62" class="dg-label dg-label--spark dg-label--center">action</text>

		<path class="dg-edge dg-edge--cyan" marker-end="url(#ael-cyan)"
			d="M 610 134 L 280 134" />
		<text x="440" y="158" class="dg-label dg-label--cyan dg-label--center">state + reward</text>
	</svg>
</figure>
