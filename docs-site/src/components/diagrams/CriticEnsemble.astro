---
/**
 * CriticEnsemble — REDQ's in-target ensemble subsampling.
 *
 * The single idea the diagram has to land: the ensemble is large but the
 * *minimum* is taken over a small random draw from it. Highlighting two of ten
 * and labelling the draw as re-sampled every update is the whole distinction
 * from "SAC with more critics", which is what REDQ is usually mistaken for.
 *
 * The dashed enclosure is not decoration — it marks what `BlockLinear`
 * collapses into one kernel, which is what makes N = 10 affordable.
 */

const N = 10;

/** Indices drawn for this update. Non-adjacent, since the draw is uniform. */
const SUBSET = [2, 7];

const ROW_H = 26;
const ROW_GAP = 5;
const TOP = 48;
const BOX_X = 312;
const BOX_W = 196;

/** Held in a binding: a literal `{` in Astro markup opens an expression. */
const TARGET = 'y = r + γ ( min_(i ∈ M) Q′ᵢ(s′,a′) − α log π(a′|s′) ),   M ⊂ {1…N}, |M| = 2';
---

<figure class="diagram not-content">
	<svg viewBox="0 0 880 400" role="img"
		aria-label="REDQ: the bootstrap target takes the minimum over a random subset of two critics drawn from an ensemble of ten">
		<defs>
			<marker id="ce-cyan" viewBox="0 0 10 10" refX="9" refY="5"
				markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" class="dg-fill-cyan" />
			</marker>
			<marker id="ce-spark" viewBox="0 0 10 10" refX="9" refY="5"
				markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" class="dg-fill-spark" />
			</marker>
		</defs>

		<!-- the query -->
		<g class="dg-node dg-node--cyan">
			<rect x="20" y="164" width="180" height="72" rx="10" />
			<text x="110" y="192" class="dg-title">(s′, a′)</text>
			<text x="110" y="214" class="dg-sub">a′ ~ π(·|s′)</text>
		</g>
		<path class="dg-edge dg-edge--cyan" marker-end="url(#ce-cyan)"
			d="M 200 200 L 296 200" />

		<!-- the ensemble -->
		<rect class="dg-group" x={BOX_X - 16} y={TOP - 18}
			width={BOX_W + 32} height={N * (ROW_H + ROW_GAP) + 26} rx="12" />
		<text x={BOX_X + BOX_W / 2} y={TOP - 28} class="dg-caption">
			BlockLinear — one kernel
		</text>

		{
			Array.from({ length: N }, (_, i) => {
				const y = TOP + i * (ROW_H + ROW_GAP);
				const hot = SUBSET.includes(i);
				return (
					<g class={hot ? 'dg-node dg-node--spark' : 'dg-node dg-node--muted'}>
						<rect x={BOX_X} y={y} width={BOX_W} height={ROW_H} rx="6" />
						<text x={BOX_X + BOX_W / 2} y={y + 18} class={hot ? 'dg-title' : 'dg-sub'}
							style="font-size:13px">
							{`Q${i + 1}′`}
						</text>
					</g>
				);
			})
		}

		<!-- only the drawn subset reaches the min -->
		{
			SUBSET.map((i) => {
				const y = TOP + i * (ROW_H + ROW_GAP) + ROW_H / 2;
				return (
					<path class="dg-edge dg-edge--spark" marker-end="url(#ce-spark)"
						d={`M ${BOX_X + BOX_W} ${y} L 560 ${y} L 560 200 L 616 200`} />
				);
			})
		}

		<g class="dg-node dg-node--spark">
			<rect x="620" y="164" width="220" height="72" rx="10" />
			<text x="730" y="192" class="dg-title">min over the draw</text>
			<text x="730" y="214" class="dg-sub">M = 2 of N = 10</text>
		</g>

		<text x="620" y="284" class="dg-sub dg-sub--left">Re-drawn every update, so the</text>
		<text x="620" y="306" class="dg-sub dg-sub--left">pessimism stays near SAC's while</text>
		<text x="620" y="328" class="dg-sub dg-sub--left">the ensemble cuts variance.</text>
	</svg>

	<figcaption class="diagram__legend">
		<span class="diagram__key diagram__key--cyan">target query</span>
		<span class="diagram__key diagram__key--spark">this update's random subset</span>
		<span class="diagram__key diagram__key--muted">the rest of the ensemble</span>
	</figcaption>

	<div class="diagram__formula">
		<span class="diagram__formula-title">bootstrap target</span>
		<code>{TARGET}</code>
	</div>
</figure>
