# LIBERO's object registry, as data — L1 of docs/LIBERO_PORT_ASSESSMENT_2026_09_13.md
#
# A `.bddl` names a CATEGORY (`akita_black_bowl - akita_black_bowl`); the asset
# file, the reset-rotation range and the articulation thresholds live in
# LIBERO's Python (`envs/objects/*.py`, `@register_object`). This file is that
# registry transcribed, so the importer can emit a real path instead of
# `TODO:<category>`.
#
# ⚠ EVERY NUMBER HERE WAS READ OUT OF LIBERO-master ON 2026-09-13 AND IS
# QUOTED, NOT CHOSEN. `rotation=` is `self.rotation` (radians, uniform range
# sampled at reset about `axis=`); the articulation lines are the `is_open` /
# `is_close` / `turn_on` / `turn_off` comparisons VERBATIM, direction included:
#
#     WoodenCabinet.is_open : qpos <  max([-0.16, -0.14])  ->  open=lt:-0.14
#     WoodenCabinet.is_close: qpos >  min([0.0, 0.005])    ->  close=gt:0.0
#     Microwave.is_open     : qpos <  max([-2.094, -1.3])  ->  open=lt:-1.3
#     Microwave.is_close    : qpos >  min([-0.005, 0.0])   ->  close=gt:-0.005
#     FlatStove.turn_on     : qpos >= min([0.5, 2.1])      ->  on=ge:0.5
#     FlatStove.turn_off    : qpos <  max([-0.005, 0.0])   ->  off=lt:0.0
#
# ⚠⚠ THE DIRECTION IS PER CLASS AND IS NOT THE SIGN OF THE RANGE. `ShortCabinet`
# (unused by any task, kept as the counter-example) opens POSITIVE:
# `qpos > min([0.10, 0.16])`. A reader that inferred `<` from a negative range
# would be right on the two cabinets that matter and wrong on that one.
#
# `asset=` is relative to the pack root (the LIBERO `assets/` directory).
# `kind=workspace` marks the arena's own table/floor: it is the BASE scene, not
# a slot, and carries no asset. The `problem=` records map a `.bddl`'s
# `(problem NAME)` onto its arena, workspace offset and z offset
# (`envs/problems/*.py`), which is what a fixture's static pose is computed
# from: x,y = rect centre + offset, z = z_offset + offset_z - bottom_site_z.
schema_version=1

# ── problem classes (5 of LIBERO's 6 appear in the 130 files) ─────────────
# floor_texture / wall_texture are the RESOLVED filenames from
# envs/arenas/style.py, applied to the arena's `texplane` / `tex-wall` at load.
#
# base_pos= is where the Panda's ROOT body goes: robosuite's `set_base_xpos`
# writes `xpos - bottom_offset`, with xpos from `base_xpos_offset[<arena>]`
# (table/kitchen: -0.16 - L/2; study: -0.25 - L/2; floor ("empty"): -0.6) and
# bottom_offset = mount.bottom_offset - mount.top_offset = -0.922 - (-0.01)
# = -0.912, so z = 0.912 — for `robot=mounted` (MountedPanda: tabletop,
# kitchen, study). ⚠ LIVING ROOM AND FLOOR USE `OnTheGroundPanda`
# (`robot=on_the_ground`): NO mount, bottom_offset 0, so the root goes
# exactly to `base_xpos_offset`: living_room_table `(-0.16 - L/2, 0, 0.42)`
# with L = 0.70 = (-0.51, 0, 0.42); floor ("empty") = (-0.6, 0, 0). The
# vendoring tool writes both variants from the same three source XMLs.
#
# table_size= / table_friction= exist only where LIBERO's arena class calls
# `configure_location` (TableArena, KitchenTableArena): the table body is
# re-posed to `workspace_offset - (0,0,h/2)`, its box to the half size, the
# `table_top` site to (0,0,h/2), the legs to the corners. The study arena
# DEFINES configure_location and never calls it; living room and floor have
# none. Those three keep the table as authored.
#
# camera= lines are the `_setup_camera` overrides of each problem class
# (`agentview` is what the benchmark renders; `frontview` is kept for the
# viewer). galleryview / paperview are visualisation-only and are not carried.
#
# zone_z= is the WORLD z of a table target zone's site — where `On(obj,
# <table region>)` measures its band from (`TargetZone` + `under`, L3). Each
# problem class appends the zone site to a different body with a different
# z_offset convention, quoted:
#     Tabletop     : table body z 0.875, `pos=target_zone.pos`, TargetZone
#                    default z_offset=0.02                    -> 0.895
#     Kitchen      : table body z 0.875, z_offset=workspace_offset[2]=0.90,
#                    `pos + (0,0,-0.90)`                      -> 0.875
#     Living room  : living_room_table body z 0, z_offset=0.41 -> 0.41
#     Study        : study_table body z 0, z_offset=0.867      -> 0.867
#     Floor        : floor body z 0, default z_offset=0.02     -> 0.02
# `gen_libero_arenas.py` places `<site name="zone_plane">` there; the
# importer anchors every table box region on it.
problem=LIBERO_Tabletop_Manipulation
robot=mounted
scene=scenes/libero_tabletop_base_style.xml
workspace=table
workspace_offset=0,0,0.90
z_offset=-0.04
zone_z=0.895
floor_texture=textures/light-gray-floor-tile.png
wall_texture=textures/light-gray-plaster.png
base_pos=-0.66,0,0.912
table_size=1.0,1.2,0.05
table_friction=0.6,0.005,0.0001
camera=agentview:0.6586131746834771,0.0,1.6103500240372423:0.6380177736282349,0.3048497438430786,0.30484986305236816,0.6380177736282349
camera=frontview:1.0,0.0,1.48:0.56,0.43,0.43,0.56

problem=LIBERO_Kitchen_Tabletop_Manipulation
robot=mounted
scene=scenes/libero_kitchen_tabletop_base_style.xml
workspace=kitchen_table
workspace_offset=0,0,0.90
z_offset=-0.04
zone_z=0.875
floor_texture=textures/gray_ceramic_tile.png
wall_texture=textures/yellow_linen_wall_texture.png
base_pos=-0.66,0,0.912
table_size=1.0,1.2,0.05
table_friction=1,0.005,0.0001
camera=agentview:0.6586131746834771,0.0,1.6103500240372423:0.6380177736282349,0.3048497438430786,0.30484986305236816,0.6380177736282349
camera=frontview:1.0,0.0,1.48:0.56,0.43,0.43,0.56

problem=LIBERO_Living_Room_Tabletop_Manipulation
robot=on_the_ground
scene=scenes/libero_living_room_tabletop_base_style.xml
workspace=living_room_table
workspace_offset=0,0,0.41
z_offset=-0.014
zone_z=0.41
floor_texture=textures/seamless_wood_planks_floor.png
wall_texture=textures/light-gray-plaster.png
base_pos=-0.51,0,0.42
camera=agentview:0.6065773716836134,0.0,0.96:0.6182166934013367,0.3432307541370392,0.3432314395904541,0.6182177066802979
camera=frontview:1.5,0.0,0.9:0.56,0.43,0.43,0.56

problem=LIBERO_Study_Tabletop_Manipulation
robot=mounted
scene=scenes/libero_study_base_style.xml
