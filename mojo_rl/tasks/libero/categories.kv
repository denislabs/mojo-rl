z_offset=-0.04
zone_z=0.867
floor_texture=textures/light-gray-floor-tile.png
wall_texture=textures/light-gray-plaster.png
base_pos=-0.75,0,0.912
camera=agentview:0.4586131746834771,0.0,1.6103500240372423:0.6380177736282349,0.3048497438430786,0.30484986305236816,0.6380177736282349
camera=frontview:1.0,0.0,1.48:0.56,0.43,0.43,0.56

problem=LIBERO_Floor_Manipulation
robot=on_the_ground
scene=scenes/libero_floor_base_style.xml
workspace=floor
workspace_offset=0,0,-0.035
z_offset=-0.025
zone_z=0.02
floor_texture=textures/light-gray-floor-tile.png
wall_texture=textures/light-gray-plaster.png
base_pos=-0.6,0,0
camera=agentview:0.8965773716836134,0.0,0.65:0.6182166934013367,0.3432307541370392,0.3432314395904541,0.6182177066802979
camera=frontview:1.0,0.0,0.65:0.56,0.43,0.43,0.56

# ── workspaces: the arena is the base scene ───────────────────────────────
category=table
kind=workspace

category=kitchen_table
kind=workspace

category=living_room_table
kind=workspace

category=study_table
kind=workspace

category=floor
kind=workspace

# ── articulated fixtures (envs/objects/articulated_objects.py) ────────────
# base rotation (pi/4, pi/2) about x is ArticulatedObject's default; as
# FIXTURES they are placed by the region's yaw about z, so it is unused there.
category=wooden_cabinet
kind=asset
asset=articulated_objects/wooden_cabinet.xml
rotation=0.7853981633974483,1.5707963267948966
axis=x
open=lt:-0.14
close=gt:0.0

category=white_cabinet
kind=asset
asset=articulated_objects/white_cabinet.xml
rotation=0.7853981633974483,1.5707963267948966
axis=x
open=lt:-0.14
close=gt:0.0

category=microwave
kind=asset
asset=articulated_objects/microwave.xml
rotation=0.7853981633974483,1.5707963267948966
axis=x
open=lt:-1.3
close=gt:-0.005

category=flat_stove
kind=asset
asset=articulated_objects/flat_stove.xml
rotation=0,0
axis=y
on=ge:0.5
off=lt:0.0

# unused by any task; the counter-example for the direction rule
category=short_cabinet
kind=asset
asset=articulated_objects/short_cabinet.xml
rotation=0.7853981633974483,1.5707963267948966
axis=x
open=gt:0.10
close=lt:0.0

