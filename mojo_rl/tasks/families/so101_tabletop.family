# The first task family — SO-ARM101 on a tabletop.
#
# ⚠ THE SLOT TABLE IS THE BUDGET. Every task in this family instantiates every
# slot below, active or not, so nq/nv/ngeom are CONSTANT across the family and
# the GPU leg stays one monomorphisation (TASK_LAYER_PLAN.md §3.1).
#
# ⚠ THREE FREE SLOTS, NOT SIX. Measured on an RTX 5090 at 1024 lanes
# (TASK_LAYER_IMPLEMENTATION.md §1.0): three free slots cost 1.51x the bare
# arm, six cost 2.74x, and thirteen is the compile ceiling. The table is a
# FIXTURE and costs nothing — it carries no free joint, so it adds no dofs and
# pays none of the solver's superlinear term. Widen with fixtures freely; add
# a free slot only when a task needs to MOVE the thing.
schema_version=1
family=so101_tabletop
base=mojo_rl/envs/robots/assets/so_arm101.xml
horizon=300
control_freq=20

# ⚠ THE FIXTURE CARRIES ITS POSE. A static slot has no joint, so where it is
# composed is where it stays — parking it would weld the table 50 m up and
# take the region on its surface with it.
#
# ⚠⚠ z 0.01, NOT 0.30 — A LOW PLATFORM ON THE FLOOR, NOT A SHELF AT CHEST
# HEIGHT. The 1 cm half-thickness puts the bottom face on the floor plane and
# the top at z 0.02, so props rest at 0.04.
#
# The first version used 0.30 and it was wrong in a way reachability analysis
# alone does NOT catch: the gripper SITE can reach (0.25, 0, 0.33) — measured,
# 10.8 mm from a sampled pose — but the slab is a 30x30x2 cm plate floating in
# the MIDDLE of the arm's workspace. The arm has to reach over it, its links
# collide with it on most approach paths, and because nothing holds it up the
# arm can also pass UNDER it. "Can the end effector be at that point" and "can
# the arm work there" are different questions, and only the second one matters.
#
# ⚠ SO-101 IS A DESK ARM BOLTED TO A SURFACE. Its base is at z 0 and the work
# surface belongs at z 0 too — the props go beside it, not above it.
slot=table:static:mojo_rl/tasks/assets/props/fixture.xml:0.25,0.0,0.01
slot=brick:free:mojo_rl/tasks/assets/props/cube.xml
slot=cube_a:free:mojo_rl/tasks/assets/props/cube.xml
slot=cube_b:free:mojo_rl/tasks/assets/props/cube.xml

park=10.0,0.0,50.0

# ⚠ THE SITE NAME IS THE COMPOSED ONE: `<slot prefix>_<site in the asset>`.
# `<attach prefix=>` renames every element of the asset, so the site declared
# as `surface` in fixture.xml is `table_surface` once the `table` slot
# instantiates it. Naming the raw asset site here would resolve to nothing.
region=table_top:site:table_surface:-0.10,-0.10,0.10,0.10
