def build_font_atlas_r8() -> List[UInt8]:
    """Expand packed font bitmap to a 128×64 R8 atlas for GPU upload.

    Each glyph occupies an 8×8 block. Atlas layout:
      16 glyphs per row × 8 rows = 128 glyphs.
      Glyph c: col = c%16, row = c/16.

    Returns:
        128×64 UInt8 array, one byte per pixel (0 or 255).
    """
    var bitmap = _make_font_bitmap()
    var atlas = List[UInt8](capacity=8192)
    for _ in range(8192):
        atlas.append(UInt8(0))
    for c in range(128):
        var glyph_col = c % 16
        var glyph_row = c // 16
        for row in range(8):
            var byte = Int(bitmap[c * 8 + row])
            for col in range(8):
                # LSB = leftmost pixel
                var bit = (byte >> col) & 1
                var atlas_x = glyph_col * 8 + col
                var atlas_y = glyph_row * 8 + row
                var idx = atlas_y * 128 + atlas_x
                atlas[idx] = UInt8(255) if bit != 0 else UInt8(0)

    # ⚠ CELL 0 IS OVERWRITTEN AS A SOLID BLOCK. A screen-space UI needs filled
    # rectangles, and the only 2D pipeline here is the font's textured-quad
    # path — so a rect is a quad whose UVs point at an opaque texel. The atlas
    # had none (two 0xFF bytes in the entire bitmap, both inside glyph shapes).
    # ASCII 0 is NUL: no text draws it, so claiming it costs nothing.
    for row in range(8):
        for col in range(8):
            atlas[row * 128 + col] = UInt8(255)
    return atlas^


def glyph_uv(c: UInt8) -> Tuple[Float32, Float32, Float32, Float32]:
    """Return (u0, v0, u1, v1) atlas UV coordinates for ASCII character c.

    Args:
        c: ASCII character code (0-127).

    Returns:
        Tuple of (u0, v0, u1, v1) normalized UV coordinates.
    """
    var ci = Int(c) & 127
    var glyph_col = Float32(ci % 16)
    var glyph_row = Float32(ci // 16)
    var u0 = glyph_col / 16.0
    var v0 = glyph_row / 8.0
    var u1 = u0 + 1.0 / 16.0
    var v1 = v0 + 1.0 / 8.0
    return (u0, v0, u1, v1)


def solid_uv() -> Tuple[Float32, Float32, Float32, Float32]:
    """UVs of an opaque texel, for filled rectangles.

    Samples the MIDDLE of cell 0 rather than its full extent: at the cell
    boundary a linear sampler blends into the neighbouring glyph, which shows
    up as a faint fringe along a rectangle's edge.
    """
    var u = 4.0 / 128.0  # centre of the 8x8 cell at (0,0)
    var v = 4.0 / 64.0
    return (Float32(u), Float32(v), Float32(u), Float32(v))
