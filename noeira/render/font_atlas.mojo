"""Font atlas for GPU text rendering.

Classic 8×8 monospace bitmap font (public domain, based on font8x8).
128 glyphs × 8 bytes = 1024 bytes packed bitmap.
Each byte is one pixel row; bit 0 (LSB) = leftmost pixel.

Expanded to R8_UNORM atlas: 128×64 pixels (16 cols × 8 rows of glyphs).
Glyph 'c': col = c%16, row = c/16.  UV = (col/16, row/8) to ((col+1)/16, (row+1)/8).
"""


comptime FONT_GLYPH_W = 8
comptime FONT_GLYPH_H = 8
comptime FONT_ATLAS_COLS = 16  # glyphs per row in atlas
comptime FONT_ATLAS_ROWS = 8  # rows of glyphs in atlas
comptime FONT_ATLAS_W = 128  # atlas width  in pixels (16 * 8)
comptime FONT_ATLAS_H = 64  # atlas height in pixels  (8 * 8)


def _make_font_bitmap() -> List[UInt8]:
    """Build 8×8 bitmap font for ASCII 0-127 (LSB = leftmost pixel).

    Based on the public-domain font8x8 library by Daniel Hepper.
    """
    var d = List[UInt8](capacity=1024)
    for _ in range(1024):
        d.append(UInt8(0))
    # --- 0x20 space: all zeros (already zero) ---
    # --- 0x21 ! ---
    d[0x21 * 8 + 0] = 0x18
    d[0x21 * 8 + 1] = 0x3C
    d[0x21 * 8 + 2] = 0x3C
    d[0x21 * 8 + 3] = 0x18
    d[0x21 * 8 + 4] = 0x18
    d[0x21 * 8 + 5] = 0x00
    d[0x21 * 8 + 6] = 0x18
    d[0x21 * 8 + 7] = 0x00
    # --- 0x22 " ---
    d[0x22 * 8 + 0] = 0x36
    d[0x22 * 8 + 1] = 0x36
    d[0x22 * 8 + 2] = 0x00
    d[0x22 * 8 + 3] = 0x00
    d[0x22 * 8 + 4] = 0x00
    d[0x22 * 8 + 5] = 0x00
    d[0x22 * 8 + 6] = 0x00
    d[0x22 * 8 + 7] = 0x00
    # --- 0x23 # ---
    d[0x23 * 8 + 0] = 0x36
    d[0x23 * 8 + 1] = 0x36
    d[0x23 * 8 + 2] = 0x7F
    d[0x23 * 8 + 3] = 0x36
    d[0x23 * 8 + 4] = 0x7F
    d[0x23 * 8 + 5] = 0x36
    d[0x23 * 8 + 6] = 0x36
    d[0x23 * 8 + 7] = 0x00
    # --- 0x24 $ ---
    d[0x24 * 8 + 0] = 0x0C
    d[0x24 * 8 + 1] = 0x3E
    d[0x24 * 8 + 2] = 0x03
    d[0x24 * 8 + 3] = 0x1E
    d[0x24 * 8 + 4] = 0x30
    d[0x24 * 8 + 5] = 0x1F
    d[0x24 * 8 + 6] = 0x0C
    d[0x24 * 8 + 7] = 0x00
    # --- 0x25 % ---
    d[0x25 * 8 + 0] = 0x00
    d[0x25 * 8 + 1] = 0x63
    d[0x25 * 8 + 2] = 0x33
    d[0x25 * 8 + 3] = 0x18
    d[0x25 * 8 + 4] = 0x0C
    d[0x25 * 8 + 5] = 0x66
    d[0x25 * 8 + 6] = 0x63
    d[0x25 * 8 + 7] = 0x00
    # --- 0x26 & ---
    d[0x26 * 8 + 0] = 0x1C
