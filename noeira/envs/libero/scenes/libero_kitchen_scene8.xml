<mujoco model="libero_kitchen_scene8">
  <compiler angle="radian" inertiagrouprange="0 0" autolimits="true"/>
  <option timestep="0.002" impratio="20" cone="elliptic" density="1.2" viscosity="0.00002" />
  <asset>
    <model name="panda_robosuite" file="../../robots/assets/panda_robosuite.xml"/>
    <model name="libero_kitchen_tabletop_manipulation_arena" file="../arenas/libero_kitchen_tabletop_manipulation_arena.xml"/>
    <model name="flat_stove" file="../objects/flat_stove.xml"/>
    <model name="moka_pot_free" file="../objects/moka_pot_free.xml"/>
  </asset>
  <worldbody>
    <frame pos="-0.66 0.0 0.912" quat="1.0 0.0 0.0 0.0">
      <attach model="panda_robosuite" prefix="robot_"/>
    </frame>
    <frame pos="0.0 0.0 0.0" quat="1.0 0.0 0.0 0.0">
      <attach model="libero_kitchen_tabletop_manipulation_arena" prefix="arena_"/>
    </frame>
    <frame pos="-0.2 -0.2 0.905" quat="1.0 0.0 0.0 0.0">
      <attach model="flat_stove" prefix="flat_stove_1_"/>
    </frame>
    <frame pos="11.0 0.0 50.0" quat="1.0 0.0 0.0 0.0">
      <attach model="moka_pot_free" prefix="moka_pot_1_"/>
    </frame>
    <frame pos="11.5 0.0 50.0" quat="1.0 0.0 0.0 0.0">
      <attach model="moka_pot_free" prefix="moka_pot_2_"/>
    </frame>
  </worldbody>
</mujoco>
