<mujoco model="libero_study_scene4">
  <compiler angle="radian" inertiagrouprange="0 0" autolimits="true"/>
  <option timestep="0.002" impratio="20" cone="elliptic" density="1.2" viscosity="0.00002" />
  <asset>
    <model name="panda_robosuite" file="../../robots/assets/panda_robosuite.xml"/>
    <model name="libero_study_tabletop_manipulation_arena" file="../arenas/libero_study_tabletop_manipulation_arena.xml"/>
    <model name="wooden_two_layer_shelf" file="../objects/wooden_two_layer_shelf.xml"/>
    <model name="black_book_free" file="../objects/black_book_free.xml"/>
    <model name="yellow_book_free" file="../objects/yellow_book_free.xml"/>
  </asset>
  <worldbody>
    <frame pos="-0.75 0.0 0.912" quat="1.0 0.0 0.0 0.0">
      <attach model="panda_robosuite" prefix="robot_"/>
    </frame>
    <frame pos="0.0 0.0 0.0" quat="1.0 0.0 0.0 0.0">
      <attach model="libero_study_tabletop_manipulation_arena" prefix="arena_"/>
    </frame>
    <frame pos="-0.2 0.28 0.887" quat="1.0 0.0 0.0 0.0">
      <attach model="wooden_two_layer_shelf" prefix="wooden_two_layer_shelf_1_"/>
    </frame>
    <frame pos="11.0 0.0 50.0" quat="1.0 0.0 0.0 0.0">
      <attach model="black_book_free" prefix="black_book_1_"/>
    </frame>
    <frame pos="11.5 0.0 50.0" quat="1.0 0.0 0.0 0.0">
      <attach model="yellow_book_free" prefix="yellow_book_1_"/>
    </frame>
    <frame pos="12.0 0.0 50.0" quat="1.0 0.0 0.0 0.0">
      <attach model="yellow_book_free" prefix="yellow_book_2_"/>
    </frame>
  </worldbody>
</mujoco>
