<mujoco model="wrap_arm">
  <!--
    A hinge arm whose tendon runs past two wrap objects: a CYLINDER with no
    sidesite (the tendon takes whichever side is shorter) and a SPHERE with
    one (the modeller's choice wins). Sweeping `hinge` moves the tip site
    across both, so the sweep crosses the wrap/no-wrap transition in each —
    which a fixed pose cannot do, and which is where `mju_wrap`'s early
    returns and the routing loop's `j += 2` disagree if either is wrong.

    Deliberately NOT a robot: every number here is chosen so the two objects
    engage at different angles rather than to look like anything.
  -->
  <compiler angle="radian"/>
  <option gravity="0 0 0"/>

  <worldbody>
    <site name="anchor" pos="-0.40 0.00 0.00" size="0.004"/>

    <geom name="pulley" type="cylinder" size="0.06 0.05" pos="-0.10 0.00 0.00"
          contype="0" conaffinity="0" rgba="0.2 0.8 0.3 0.4"/>

    <geom name="ball" type="sphere" size="0.05" pos="0.14 0.05 0.00"
          contype="0" conaffinity="0" rgba="0.8 0.3 0.2 0.4"/>
    <site name="ball_side" pos="0.14 0.14 0.00" size="0.004"/>

    <body name="arm" pos="0.30 0.00 0.00">
      <joint name="hinge" type="hinge" axis="0 0 1" pos="0 0 0"
             limited="false" damping="0.01"/>
      <geom name="arm_g" type="capsule" fromto="0 0 0 0.18 0 0" size="0.01"
            contype="0" conaffinity="0"/>
      <site name="tip" pos="0.18 0.00 0.00" size="0.004"/>
    </body>
  </worldbody>

  <tendon>
    <spatial name="t_cyl" width="0.002" rgba="0.9 0.7 0.1 1">
      <site site="anchor"/>
      <geom geom="pulley"/>
      <site site="tip"/>
    </spatial>
    <spatial name="t_sph" width="0.002" rgba="0.1 0.7 0.9 1">
      <site site="anchor"/>
      <geom geom="ball" sidesite="ball_side"/>
      <site site="tip"/>
    </spatial>
  </tendon>
</mujoco>
