<mujoco model="scene_deg">
  <!-- No <compiler angle>: MuJoCo reads this scene as DEGREE. -->
  <asset>
    <model name="a" file="rad_asset.xml"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="1 1 0.1"/>
    <body name="mount" pos="0 0 0.5" euler="0 0 90">
      <attach model="a" prefix="a_"/>
    </body>
    <body name="mount2" pos="0.5 0 0.5">
      <attach model="a" prefix="b_"/>
    </body>
  </worldbody>
</mujoco>
